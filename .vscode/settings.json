{
  "editor.codeActionsOnSave": {
    // fix all auto-fixable issues on save, but only if the file has an explicit "fix all" code action (e.g. ts/tsx/js/jsx), to avoid unwanted edits in other file types
    "source.fixAll": "explicit",
    // organize imports on save, but only if the file has an explicit "organize imports" code action (e.g. ts/tsx/js/jsx), to avoid unwanted edits in other file types
    "source.organizeImports": "explicit",
    // sort members like type/interface properties, enum members, object properties, class members, etc.
    "source.sortMembers": "explicit"
  },
  // prettier on save based on editorconfig
  "editor.formatOnSave": true,
  // insert spaces instead of tab
  "editor.insertSpaces": true,
  // set the number of spaces for indentation
  "prettier.tabWidth": 2,
  // use spaces instead of tabs
  "prettier.useTabs": false,
  // add a semicolon at the end of every statement
  "prettier.trailingComma": "none",
  // specify the line length that the printer will wrap on
  "prettier.printWidth": 80,
  // trim trailing whitespace on save
  "files.trimTrailingWhitespace": true,
  // set the default formatter to Prettier
  "editor.defaultFormatter": "esbenp.prettier-vscode"
}
